# 统一环境变量：后端与前端共用此文件
APP_NAME=Business Attribution System
API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./data/app.db
BUSINESS_DATABASE_URL=sqlite+aiosqlite:///./data/business.db

JWT_SECRET=change-me-demo-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AUTH_MODE=demo
AUTH_CENTER_BASE_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
FRONTEND_BASE_URL=http://127.0.0.1:5173
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_CORRECTIONS=2

SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=200
